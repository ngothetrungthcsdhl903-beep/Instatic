{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/index.ts",
    "server/healthcheck.ts",
    "scripts/**/*.ts",
    "src/__tests__/**/*.{test,spec}.{ts,tsx}",
    "server/**/__tests__/**/*.test.ts",
    "server/plugins/quickjs/bootstrap/src/*.ts",
    "src/admin/plugin-host-ui/index.ts",
    "src/admin/plugin-host-hooks/index.ts",
    "src/core/plugin-sdk/index.ts",
    "src/core/plugin-sdk/cli/*.ts",
    "src/core/**/index.ts",
    "src/keijam/index.ts",
    "src/modules/**/index.ts",
    "src/ui/components/**/index.ts",
    "server/**/index.ts"
  ],
  "ignoreBinaries": ["fallow"],
  "ignoreExportsUsedInFile": true,
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/inter",
    "dependency-cruiser",
    "jscpd",
    "madge",
    "secretlint",
    "@secretlint/secretlint-rule-preset-recommend"
  ]
}
